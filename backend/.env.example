# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default, local dev — no setup needed)
DATABASE_URL=sqlite:///./safeguide.db
# Production: Neon Postgres (https://neon.tech — permanent free tier).
# Copy the "Connection string" from the Neon dashboard; it already ends in
# ?sslmode=require, which Neon requires. The app auto-normalizes postgres:// -> postgresql://.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/safeguide?sslmode=require

# ── Auth ───────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# ── AI Provider ────────────────────────────────────────────────────────────────
# Options: ollama | groq | openrouter
AI_PROVIDER=ollama

# Ollama (local)
OLLAMA_MODEL=llama3

# Groq (https://console.groq.com)
# AI_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.1-8b-instant

# OpenRouter (https://openrouter.ai)
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── App ────────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:5173
